# Public Supabase settings. Values prefixed with VITE_ are embedded in the browser bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side equivalents used by SSR and authenticated server functions.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Vercel AI Gateway uses VERCEL_OIDC_TOKEN automatically after `vercel env pull`.
# Outside Vercel, use a server-only AI_GATEWAY_API_KEY instead.
AI_GATEWAY_API_KEY=
