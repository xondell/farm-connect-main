# Public Supabase settings. Values prefixed with VITE_ are embedded in the browser bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side equivalents used by SSR and authenticated server functions.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only key for the AI chat route. Never prefix this with VITE_.
AI_GATEWAY_API_KEY=
